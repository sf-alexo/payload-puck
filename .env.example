# Local dev: file-based SQLite
DATABASE_URL=file:./snf-payload-poc.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Production on Vercel (Turso):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Production on Vercel (Blob storage for media uploads — auto-injected when
# you connect a Blob store to the project):
# BLOB_READ_WRITE_TOKEN=
